# Public AWS/Cognito settings for the frontend. These are not secrets.
CAREERSIGNAL_PUBLIC_API_BASE_URL="https://<api-id>.execute-api.<region>.amazonaws.com"
CAREERSIGNAL_COGNITO_DOMAIN="https://<domain-prefix>.auth.<region>.amazoncognito.com"
CAREERSIGNAL_COGNITO_CLIENT_ID="<public-user-pool-client-id>"

# Optional links shown in the header.
CAREERSIGNAL_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/<your-profile>/"
CAREERSIGNAL_PUBLIC_GITHUB_URL="https://github.com/<your-account>"

# Local preview only. In production, set this with `wrangler secret put`.
LOGO_DEV_PUBLISHABLE_KEY="<Logo.dev key for local preview>"
