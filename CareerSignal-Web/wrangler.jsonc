{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "careersignal",
	"main": "worker.mjs",
	"compatibility_date": "2026-11-03",
	"keep_vars": true,
	"assets": {
		"directory": "./dist/careersignal/browser",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"ratelimits": [
		{
			"name": "SEARCH_SUBMIT_LIMITER",
			"namespace_id": "6419207",
			"simple": {
				"limit": 3,
				"period": 60
			}
		}
	],
	"vars": {
		"CAREERSIGNAL_COGNITO_CLIENT_ID": "4fkn612t82kddfm8kib4ra5sst",
		"CAREERSIGNAL_COGNITO_DOMAIN": "https://careersignal-baha-unique-2026.auth.us-east-1.amazoncognito.com",
		"CAREERSIGNAL_PUBLIC_API_BASE_URL": "https://271ujoy5zd.execute-api.us-east-1.amazonaws.com",
		"CAREERSIGNAL_PUBLIC_GITHUB_URL": "https://github.com/BahaEdinAbdelkhalek",
		"CAREERSIGNAL_PUBLIC_LINKEDIN_URL": "https://www.linkedin.com/in/baha-edin-abdelkhalek/"
	}
}